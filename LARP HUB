            end
            task.spawn(function()
                while getgenv().PotatoOptimizerLoaded do task.wait(5); applyLightingSettings() end
            end)
        else
            getgenv().PotatoOptimizerLoaded = false
            if getgenv().PotatoOptimizerConnection then
                getgenv().PotatoOptimizerConnection:Disconnect()
                getgenv().PotatoOptimizerConnection = nil
            end
        end
    end)

    AddKeybind(setSec, "Toggle Menu Key", Enum.KeyCode.RightAlt, "MenuKey")
    CreateThemeButton(setSec, "UI Theme", Config.Theme)
    ApplyTheme(ScreenGui, Config.Theme)

    -- ==================== LOGIC CONNECTIONS ====================
    local jumpConnection = UserInputService.JumpRequest:Connect(function()
        local humanoid, hrp = GetCharacterData()
        if Config.DirectionalJump and humanoid and hrp then
            task.defer(function()
                task.wait(0.03)
                local cameraLook = workspace.CurrentCamera.CFrame.LookVector
                local flattenedLook = Vector3.new(cameraLook.X, 0, cameraLook.Z).Unit
                if flattenedLook.Magnitude > 0 then
                    hrp.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + flattenedLook)
                    humanoid.AutoRotate = false
                end
            end)
        elseif humanoid then
            humanoid.AutoRotate = true
        end
    end)
    table.insert(connections, jumpConnection)

    local renderConnection = RunService.RenderStepped:Connect(function()
        if Config.HitboxEnabled then createOrUpdateHitboxes(Config.HitboxScale) end

        if Config.DirectionLines then
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character then
                    local isOpponent = (LocalPlayer.Team == nil or player.Team ~= LocalPlayer.Team)
                    local hrp = player.Character:FindFirstChild("HumanoidRootPart")
                    if isOpponent and hrp then
                        local rayPart = player.Character:FindFirstChild("OpponentFacingRay")
                        if not rayPart then
                            rayPart = Instance.new("Part")
                            rayPart.Name = "OpponentFacingRay"; rayPart.Anchored = true; rayPart.CanCollide = false
                            rayPart.CastShadow = false; rayPart.Material = Enum.Material.Neon
                            rayPart.Color = Color3.fromRGB(253, 8, 8); rayPart.Parent = player.Character
                        end
                        local thickness = Config.DirectionLineThickness or 0.15
                        rayPart.Size = Vector3.new(thickness, thickness, 80)
                        rayPart.CFrame = hrp.CFrame * CFrame.new(0, 0, -40)
                    else
                        if player.Character:FindFirstChild("OpponentFacingRay") then
                            player.Character.OpponentFacingRay:Destroy()
                        end
                    end
                end
            end
        end

        local humanoid, hrp = GetCharacterData()
        if Config.AirMoveEnabled and humanoid and hrp then
            local state = humanoid:GetState()
            if state == Enum.HumanoidStateType.Freefall or state == Enum.HumanoidStateType.Jumping then
                local cameraLook = workspace.CurrentCamera.CFrame.LookVector
                local flattenedLook = Vector3.new(cameraLook.X, 0, cameraLook.Z).Unit
                if flattenedLook.Magnitude > 0 then
                    hrp.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + flattenedLook)
                end
                local moveDir = humanoid.MoveDirection
                if moveDir.Magnitude > 0 then
                    hrp.Velocity = Vector3.new(moveDir.X * Config.AirMoveSpeed, hrp.Velocity.Y, moveDir.Z * Config.AirMoveSpeed)
                end
            end
        end
    end)
    table.insert(connections, renderConnection)

    local keyBindConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if (input.KeyCode == Config.MenuKey and input.KeyCode ~= Enum.KeyCode.Unknown) or (input.UserInputType == Config.MenuKey) then
            playClickSound()
            if minimized and restoreFrame then
                if restoreFrame.Visible then
                    local fadeOut = TweenService:Create(restoreFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {GroupTransparency = 1})
                    fadeOut:Play(); fadeOut.Completed:Wait(); restoreFrame.Visible = false
                else
                    restoreFrame.Visible = true
                    TweenService:Create(restoreFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {GroupTransparency = 0}):Play()
                end
                return
            end
            if MainFrame.Visible then
                local fadeOut = TweenService:Create(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {GroupTransparency = 1})
                fadeOut:Play(); fadeOut.Completed:Wait(); MainFrame.Visible = false
            else
                MainFrame.Visible = true
                TweenService:Create(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {GroupTransparency = 0}):Play()
            end
        end
    end)
    table.insert(connections, keyBindConnection)

    triggerNotification("SONION LOADED", Color3.fromRGB(255, 255, 255))
end

LoadMainHub()
